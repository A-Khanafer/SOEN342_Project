@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
hide methods
hide circle
title Iteration II conceptual domain model — refinement of iteration1/DMupdated.drawio.png
class Patient {
  patientNumber
  firstName
  lastName
  dateOfBirth
  phone
}
class Insurance {
  type: RAMQ / private
  number
  provider
}
class HealthcareProfessional {
  title
  firstName
  lastName
  licenseNumber
  professionType
}
class ClinicLocation {
  name
  address
  phone
}
class MedSpecialty {
  specialtyName
}
class MedicalService {
  name
  fee
  requiresReferral
}
class TimeSlot {
  date
  startTime
  endTime
  status: OPEN / BOOKED
}
class Appointment {
  status
  arrivalTime
}
class ClinicalRecord {
  recordNumber
  createdDate
}
class Consultation {
  observations
  diagnosis
  treatmentRecommendations
  followUpRequired
}
class Referral {
  issueDate
  clinicalReason
  priority
  status
}
class ExternalPhysician {
  name
  licenseNumber
  contact
}
class Prescription {
  issueDate
  instructions
}
class PrescriptionItem {
  dosage
  frequency
  duration
}
class Medication {
  name
}
class Invoice {
  invoiceNumber
  amount
  date
  status
}
class Payment {
  amount
  paymentDate
  method
}
class ActivityRecord {
  timestamp
  action
  performedBy
}
class WaitingList {
  name
}
class WaitlistEntry {
  priority
  requestDate
  status: WAITING / REMOVED / FULFILLED
  referralType [optional description]
  description [optional]
  fromDate [optional]
  toDate [optional]
}
class WaitlistOffer {
  offeredAt
  outcome: ACCEPTED / DECLINED
}
class Resource {
  name
  kind: room / equipment / role
}
class ResourceRequirement {
  resourceKind
  quantity
}
Patient "1" -- "0..*" Insurance : has
Patient "1" -- "0..*" Appointment : books
Patient "1" -- "1" ClinicalRecord : has
Patient "1" -- "0..*" Referral : concerns
Patient "0..1" -- "0..*" ActivityRecord : concerns
HealthcareProfessional "1" -- "0..*" Appointment : is booked for
HealthcareProfessional "0..*" -- "1..*" ClinicLocation : practises at
HealthcareProfessional "0..*" -- "0..*" MedSpecialty : has
HealthcareProfessional "1" -- "0..*" TimeSlot : has
TimeSlot "0..*" -- "1" ClinicLocation : applies at
HealthcareProfessional "0..1" -- "0..*" Referral : refers (internal issuer)
ExternalPhysician "0..1" -- "0..*" Referral : refers (external issuer)
Referral "0..*" -- "0..1" MedSpecialty : requests specialty
Referral "0..*" -- "0..1" HealthcareProfessional : requests professional
Referral "0..1" -- "0..*" Appointment : results in
Appointment "0..*" -- "1" ClinicLocation : held at
Appointment "0..*" -- "1" MedicalService : is for
Appointment "0..*" -- "1" TimeSlot : assigned to (history retained)
Appointment "1" -- "0..1" Consultation : results in
ClinicalRecord "1" -- "0..*" Consultation : contains
Consultation "1" -- "0..*" Prescription : issues
Consultation "0..1" -- "0..*" Appointment : requests follow-up
Prescription "1" -- "1..*" PrescriptionItem : contains
PrescriptionItem "0..*" -- "1" Medication : describes medication
Appointment "1" -- "0..1" Invoice : billed by
Invoice "1" -- "0..*" Payment : settled by
HealthcareProfessional "0..*" -- "1..*" MedicalService : provides
MedicalService "0..*" -- "0..1" MedSpecialty : belongs to
WaitingList "1" -- "0..*" WaitlistEntry : contains
Patient "1" -- "0..*" WaitlistEntry : requests placement
WaitlistEntry "0..*" -- "1" MedicalService : waits for
WaitlistEntry "0..*" -- "0..1" HealthcareProfessional : requests professional
WaitlistEntry "0..*" -- "0..1" MedSpecialty : requests specialty
WaitlistEntry "1" -- "0..*" WaitlistOffer : receives
WaitlistOffer "0..*" -- "1" TimeSlot : offers by telephone
WaitlistEntry "0..1" -- "0..1" Appointment : fulfilled by
MedicalService "1" -- "0..*" ResourceRequirement : requires
ResourceRequirement "0..*" -- "0..*" Resource : can be satisfied by
ClinicLocation "1" -- "0..*" Resource : provides predefined units
Appointment "0..*" -- "0..*" Resource : allocates for its interval
note bottom of TimeSlot
  {endTime > startTime; intervals are [start,end)}
  {at most one non-cancelled Appointment per slot}
  {OPEN iff no current occupant; BOOKED otherwise}
  Cancelled appointments retain the historical slot link.
  Professional/location/time agree with assigned slot.
end note
note bottom of Referral
  {exactly one internal or external issuer}
  {requests specialty, professional, or both}
  UC3 issues internal referrals only.
end note
note bottom of WaitlistEntry
  {professional, specialty, or date range supplied}
  Supplied criteria are combined; dates are inclusive.
  Acceptance alone leaves WAITING and creates no hold.
  Sample CSV descriptions alone do not establish an entry.
end note
note bottom of Resource
  Each predefined resource is one allocatable unit.
  Role units are not tied to specific personnel.
  {no overlapping active allocations of the same unit}
  {selected kind/location/quantity meet requirements}
  Cancellation releases allocation links.
end note
@enduml
