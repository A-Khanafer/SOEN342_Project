@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
hide circle
title Iteration II — waiting-list detail (subset of domain-model)
class Patient {
  patientNumber
  firstName
  lastName
  phone
}
class WaitingList {
  name
}
class WaitlistEntry {
  priority
  requestDate
  status: WAITING / REMOVED / FULFILLED
  fromDate [optional]
  toDate [optional]
  referralType [optional description]
  description [optional]
}
class WaitlistOffer {
  offeredAt
  outcome: ACCEPTED / DECLINED
}
class HealthcareProfessional
class MedSpecialty
class MedicalService
class TimeSlot {
  date
  startTime
  endTime
  status: OPEN / BOOKED
}
class Appointment {
  status
}
Patient "1" -- "0..*" WaitlistEntry : requests placement
WaitingList "1" -- "0..*" WaitlistEntry : contains
WaitlistEntry "0..*" -- "1" MedicalService : waits for
WaitlistEntry "0..*" -- "0..1" HealthcareProfessional : requests professional
WaitlistEntry "0..*" -- "0..1" MedSpecialty : requests specialty
WaitlistEntry "1" -- "0..*" WaitlistOffer : receives
WaitlistOffer "0..*" -- "1" TimeSlot : offers by telephone
WaitlistEntry "0..1" -- "0..1" Appointment : fulfilled by
Appointment "0..*" -- "1" TimeSlot : assigned to (history retained)
note bottom of WaitlistEntry
  At least one professional, specialty or date criterion.
  All supplied criteria must match; dates inclusive.
  Acceptance records an offer without holding the slot.
  Successful ordinary booking marks the entry FULFILLED.
end note
@enduml
