<mxfile host="app.diagrams.net"><diagram name="SSD UC1-S Request Appointment" id="p1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="666" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="&lt;b&gt;SSD UC1-S: Request Appointment, main success scenario M1-M8 (SO01, SO26, SO02)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="940" height="30" as="geometry" /></mxCell><mxCell id="a" value=":AdministrativeStaff" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;portConstraint=eastwest;fontStyle=4;size=60;" vertex="1" parent="1"><mxGeometry x="155" y="45" width="30" height="606" as="geometry" /></mxCell><mxCell id="s" value=":System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fontStyle=4;size=40;" vertex="1" parent="1"><mxGeometry x="635" y="45" width="170" height="606" as="geometry" /></mxCell><mxCell id="c2" value="Context: Administrative Staff identified. The Patient is at the front desk or on the phone (supporting actor, talks to the staff, not to the System)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80.0" y="140.0" width="740.0" height="38.0" as="geometry" /></mxCell><mxCell id="c3" value="m1: startBooking(patientKey)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="354.6" y="198.0" width="180.8" height="14.0" as="geometry" /></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="214" as="sourcePoint" /><mxPoint x="720.0" y="214" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c5" value="SO01 (M1). patientKey = the Patient&#x27;s phone number or patient number." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80.0" y="240.0" width="740.0" height="24.0" as="geometry" /></mxCell><mxCell id="c6" value="patient (name, patient number)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="348.5" y="284.0" width="193.0" height="14.0" as="geometry" /></mxCell><mxCell id="c7" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720.0" y="300" as="sourcePoint" /><mxPoint x="170" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c8" value="m2: searchAvailability(criteria)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="342.4" y="368.0" width="205.2" height="14.0" as="geometry" /></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="384" as="sourcePoint" /><mxPoint x="720.0" y="384" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c10" value="SO26 (Part B). criteria = optional professional, specialty, fromDate, toDate; empty = any." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="104.0" y="410.0" width="692.0" height="24.0" as="geometry" /></mxCell><mxCell id="c11" value="open TimeSlots, sorted by date and start time" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="302.8" y="454.0" width="284.5" height="14.0" as="geometry" /></mxCell><mxCell id="c12" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720.0" y="470" as="sourcePoint" /><mxPoint x="170" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c13" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fontSize=11;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="90.0" y="326.0" width="720.0" height="170.0" as="geometry" /></mxCell><mxCell id="c14" value="[until a TimeSlot is agreed with the Patient (M3, include Search Availability)]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="142.0" y="345.0" width="660.0" height="18.0" as="geometry" /></mxCell><mxCell id="c15" value="m3: bookTimeSlot(timeSlot)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.7" y="508.0" width="168.6" height="14.0" as="geometry" /></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="524" as="sourcePoint" /><mxPoint x="720.0" y="524" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c17" value="SO02 (M4-M8). The chosen TimeSlot becomes BOOKED and an Appointment with status BOOKED is recorded." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80.0" y="550.0" width="740.0" height="24.0" as="geometry" /></mxCell><mxCell id="c18" value="appointment details (patient, professional, location, date and time)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" paren