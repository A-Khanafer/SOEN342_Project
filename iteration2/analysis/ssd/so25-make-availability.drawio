<mxfile host="app.diagrams.net"><diagram name="SSD Make Availability" id="p0"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p0_1" value="&lt;b&gt;SSD — Make Availability (SO25 createAvailability)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="940" height="30" as="geometry" /></mxCell><mxCell id="p0_2" value=":AdministrativeStaff" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;portConstraint=eastwest;fontStyle=4;size=60;" vertex="1" parent="1"><mxGeometry x="155" y="45" width="30" height="615" as="geometry" /></mxCell><mxCell id="p0_3" value=":System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fontStyle=4;size=40;" vertex="1" parent="1"><mxGeometry x="635.0" y="45" width="170" height="615" as="geometry" /></mxCell><mxCell id="p0_4" value="Context: Administrative Staff identified; the HealthcareProfessional and ClinicLocation have been selected." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="740" height="26.7" as="geometry" /></mxCell><mxCell id="p0_5" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="225" as="sourcePoint" /><mxPoint x="720" y="225" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_6" value="m1: createAvailability(professional, location, startDate, endDate,&lt;br&gt;pattern, startTime, endTime, slotMinutes)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="246.4" y="190.7" width="397.2" height="33.3" as="geometry" /></mxCell><mxCell id="p0_7" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;width=50;height=22;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="800" height="240" as="geometry" /></mxCell><mxCell id="p0_8" value="[inputs valid and no new slot overlaps an existing slot]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="116" y="248" width="730" height="18" as="geometry" /></mxCell><mxCell id="p0_9" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="325" as="sourcePoint" /><mxPoint x="860" y="325" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_10" value="[a new slot overlaps an existing slot]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="68" y="328" width="730" height="18" as="geometry" /></mxCell><mxCell id="p0_11" value="" style="endArrow=none;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="405" as="sourcePoint" /><mxPoint x="860" y="405" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_12" value="[invalid input: end date before start date, end time not after start time, or slotMinutes ≤ 0]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="68" y="408" width="730" height="18" as="geometry" /></mxCell><mxCell id="p0_13" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="300" as="sourcePoint" /><mxPoint x="170" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_14" value="created TimeSlots" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390.1" y="280.3" width="109.7" height="18.7" as="geometry" /></mxCell><mxCell id="p0_15" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="380" as="sourcePoint" /><mxPoint x="170" y="380" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_16" value="rejection listing the conflicting slots; nothing created" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="275.7" y="360.3" width="338.5" height="18.7" as="geometry" /></mxCell><mxCell id="p0_17" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="465" as="sourcePoint" /><mxPoint x="170" y="465" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p0_18" value="rejection: input error; nothing created" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="325.6" y="445.3" width="238.8" height="18.7" as="geometry" /></mxCell><mxCell id="p0_19" value="&lt;b&gt;pattern&lt;/b&gt; is one of: weekly (chosen days of the week), monthly (a day of the month), daily.&lt;br&gt;&lt;b&gt;Assumptions&lt;/b&gt; (pending TA confirmation):&lt;br&gt;A1. Availability is cut into bookable slots of slotMinutes (default 30, as in the sample CSV).&lt;br&gt;A2. All-or-nothing: if any new slot overlaps an existing slot of the same professional, no slot is created.&lt;br&gt;A3. Every slot applies at one ClinicLocation; slots imported from CSV use the default &quot;Main Clinic&quot;.&lt;br&gt;A4. Minutes left over that do not fill a whole slot are not used (09:00–10:45 at 30 min gives 3 slots).&lt;br&gt;A5. Slots that only touch (09:00–09:30 and 09:30–10:00) do not overlap.&lt;br&gt;A6. Each professional exists once in the system, matched by name (the CSV has no licence number); overlaps are checked per professional." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="740" height="144.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>