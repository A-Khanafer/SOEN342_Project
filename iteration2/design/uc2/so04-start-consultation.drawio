html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="770" as="sourcePoint" /><mxPoint x="1840" y="770" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p2_45" value="9: record(user, &quot;opened ClinicalRecord&quot;, p)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1013.9" y="750.3" width="262.3" height="18.7" as="geometry" /></mxCell><mxCell id="p2_46" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1840" y="810" as="sourcePoint" /><mxPoint x="1940.0" y="810" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p2_47" value="9.1: «create»" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1846.9" y="790.3" width="86.3" height="18.7" as="geometry" /></mxCell><mxCell id="p2_48" value="" style="endArrow=block;endFill=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="850" as="sourcePoint" /><mxPoint x="450" y="872" as="targetPoint" /><Array as="points"><mxPoint x="485" y="850" /><mxPoint x="485" y="872" /></Array></mxGeometry></mxCell><mxCell id="p2_49" value="10: keep context(a, cr, user)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="851.7" width="180.1" height="18.7" as="geometry" /></mxCell><mxCell id="p2_50" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="925" as="sourcePoint" /><mxPoint x="220" y="925" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p2_51" value="cr (Patient's ClinicalRecord)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="244.9" y="905.3" width="180.1" height="18.7" as="geometry" /></mxCell><mxCell id="p2_52" value="&lt;b&gt;GRASP.&lt;/b&gt; Controller: ConsultationController is the use-case controller that receives UC2 system operations and keeps the consultation context between them. Information Expert: Appointment answers canStart (status BOOKED or ARRIVED, slot date = today) and isAssignedTo, using its TimeSlot; Patient gives its ClinicalRecord (composition). Creator: ActivityLog records and creates ActivityRecords (timestamp, action, performedBy, linked to p). Pure Fabrication: AppointmentRegistry (lookup) and ActivityLog (audit).&lt;br&gt;&lt;b&gt;Design decisions.&lt;/b&gt; UserAccount is a design class for the identified user (role + linked HealthcareProfessional); the domain model has no user concept. canStart accepts ARRIVED as well as BOOKED, resolving the CO4 note that Register Arrival would otherwise block UC2." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="985" width="2030" height="52.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>