"485" y="672" /><mxPoint x="485" y="694" /></Array></mxGeometry></mxCell><mxCell id="p4_37" value="5: clear context" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="673.7" width="103.9" height="18.7" as="geometry" /></mxCell><mxCell id="p4_38" value="" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="735" as="sourcePoint" /><mxPoint x="220" y="735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p4_39" value="c recorded (Consultation)" style="text;html=1;align=center;verticalAlign=bottom;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="256.7" y="715.3" width="156.7" height="18.7" as="geometry" /></mxCell><mxCell id="p4_40" value="&lt;b&gt;GRASP.&lt;/b&gt; Creator: ClinicalRecord creates Consultation because it contains it (composition ◆). Information Expert: Appointment completes itself and records its &quot;results in&quot; link. Creator: ActivityLog creates the ActivityRecord. Controller: ConsultationController. observations = reasonForVisit + findings (CO5/CO6 proposed mapping).&lt;br&gt;&lt;b&gt;Notes.&lt;/b&gt; E7a (save failure) applies once persistence exists (Iteration III); the in-memory PoC cannot fail to save. Prescriptions and follow-ups from E5a/E5b are staged and linked to c here (CO6 proposal)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="775" width="1780" height="38.7" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>