@startuml
title UC3 — SO08 beginReferral (CO8, Iteration I pp. 12–13)
skinparam shadowing false
hide footbox
actor "Identified User" as User
participant "rc:ReferralController" as RC <<controller>>
participant "session:UserSession" as Session
participant "records:ClinicRecords" as Records
User -> RC : beginReferral(patientNumber)
activate RC
RC -> Session : getActor()
Session --> RC : actor
RC -> Session : canIssueReferral()
Session --> RC : authorized
alt unauthorized (UC3 E2a)
  RC -> Records : recordActivity(actor, null, refusalReason + patientNumber)
  create participant "denied:ActivityRecord" as Denied
  Records -> Denied : create(now, refusalReason + patientNumber, actor, null)
  Records -> Records : addActivity(denied)
  RC --> User : role not authorized; end
else authorized
  RC -> Records : findPatient(patientNumber)
  Records --> RC : p or null
  alt patient absent (UC3 E2b)
    RC -> Records : recordActivity(actor, null, patientNotRegistered + patientNumber)
    create participant "missing:ActivityRecord" as Missing
    Records -> Missing : create(now, patientNotRegistered + patientNumber, actor, null)
    Records -> Records : addActivity(missing)
    RC --> User : patient must be registered; end
  else patient found (UC3 M1–M2)
    RC -> Session : getProfessional()
    Session --> RC : issuer
    RC -> RC : retainContext(p, issuer)
    note right of RC
      currentPatient = p; currentIssuer = issuer.
      Controller attributes retain unfinished context.
      No Referral or recorded draft is created.
    end note
  end
end
deactivate RC
note over Records
  CO8 requires a refusal ActivityRecord in both failure branches.
  A missing patient leaves its optional concerns endpoint absent.
  No clinical data is returned to an unauthorized user.
end note
@enduml
